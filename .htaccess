# ============================================================
# Kamadhenu Goushala — Apache .htaccess
# Fixes: Directory listing, URL routing, security hardening
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# ── PHP Error Handling ──────────────────────────────────────
php_flag display_errors Off
php_flag log_errors On

# ── Protect Sensitive Files ─────────────────────────────────
<FilesMatch "\.(env|json|sql|log|sh|md|js\.map)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Allow specific JSON/JS that must be public (Bootstrap CDN etc.)
<Files "*.php">
  Order Allow,Deny
  Allow from all
</Files>

# Block direct access to Node.js / config folders
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block access to sensitive directories
  RewriteRule ^(config|middleware|scripts|routes|node_modules)/ - [F,L]
  RewriteRule ^(server\.js|package\.json|package-lock\.json|\.env)$ - [F,L]

  # Remove .php extension from URLs (optional clean URLs)
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteCond %{REQUEST_FILENAME}.php -f
  # RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# ── MIME Types ──────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/webp .webp
</IfModule>

# ── Browser Caching ─────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# ── Gzip Compression ────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# ── Security Headers ────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
